<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="view_project_rap_create_po_wizard_form" model="ir.ui.view">
      <field name="name">project.rap.create.po.wizard.form</field>
      <field name="model">project.rap.create.po.wizard</field>
      <field name="arch" type="xml">
        <form string="Create Purchase Order">
          <group>
            <field name="rap_id" readonly="1"/>
            <field name="pekerjaan_id"/>
            <field name="sub_pekerjaan_id"/>
          </group>

          <group>
            <field name="partner_id" domain="[('supplier_rank', '>', 0)]"/>
            <field name="deliver_to_id"/>
            <field name="expected_arrival"/>
          </group>

          <group>
            <field name="use_wizard_lines"/>
            <field name="merge_same_product" invisible="1"/>
          </group>

          <notebook invisible="use_wizard_lines == False">
            <page string="Lines">
              <field name="line_ids">
                <list editable="bottom">
                  <field name="product_id"/>
                  <field name="name"/>
                  <field name="product_qty"/>
                  <field name="product_uom"/>
                  <field name="price_unit"/>
                </list>
              </field>
            </page>
          </notebook>

          <footer>
            <button name="action_confirm_create_po" type="object" string="Create PO" class="btn-primary"/>
            <button string="Cancel" class="btn-secondary" special="cancel"/>
          </footer>
        </form>
      </field>
    </record>

  </data>
</odoo>
