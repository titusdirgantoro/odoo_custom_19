<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_project_rap_import_template_wizard_form" model="ir.ui.view">
            <field name="name">project.rap.import.template.wizard.form</field>
            <field name="model">project.rap.import.template</field>
            <field name="arch" type="xml">
                <form string="Add from Template">
                    <sheet>
                        <group>
                            <field name="rap_id" invisible="1"/>
                            <field name="template_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="mode"/>
                            <field name="duplicate_policy"/>
                            <field name="price_rule"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_import" type="object" string="Apply" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
