<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="view_project_rap_create_wo_wizard_form" model="ir.ui.view">
      <field name="name">project.rap.create.wo.wizard.form</field>
      <field name="model">project.rap.create.wo.wizard</field>
      <field name="arch" type="xml">
        <form string="Create Work Order">
          <group>
            <group>
              <field name="rap_id" readonly="1"/>
              <field name="fpd_id" required="True" options="{'no_create': True}"/>
              <field name="pekerjaan_id" invisible="1" force_save="1"/>
              <field name="sub_pekerjaan_id" invisible="1" force_save="1"/>
            </group>

            <group>
              <field name="partner_id" domain="[('supplier_rank', '>', 0)]"/>
              <field name="deliver_to_id" invisible="1" force_save="1"/>
              <field name="picking_type_id" invisible="1" force_save="1"/>
              <field name="expected_arrival"/>
            </group>
          </group>

          <notebook>
            <page string="Lines (Service Only)">
              <field name="line_ids">
                <list editable="bottom">
                  <field name="allowed_product_ids" column_invisible="1"/>
                  <field name="product_id"/>
                  <field name="name"/>
                  <field name="product_qty"/>
                  <field name="product_uom"/>
                  <field name="price_unit"/>
                </list>
              </field>
            </page>
          </notebook>

          <footer>
            <button name="action_confirm_create_wo" type="object" string="Create WO" class="btn-primary"/>
            <button string="Cancel" class="btn-secondary" special="cancel"/>
          </footer>
        </form>
      </field>
    </record>

  </data>
</odoo>
