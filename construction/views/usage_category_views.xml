<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- list view: Kategori Penggunaan Product -->
    <record id="view_construction_usage_category_tree" model="ir.ui.view">
        <field name="name">construction.usage.category.list</field>
        <field name="model">construction.usage.category</field>
        <field name="arch" type="xml">
            <list string="Kategori Penggunaan Product">
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form view: Kategori Penggunaan Product -->
    <record id="view_construction_usage_category_form" model="ir.ui.view">
        <field name="name">construction.usage.category.form</field>
        <field name="model">construction.usage.category</field>
        <field name="arch" type="xml">
            <form string="Kategori Penggunaan Product">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: Kategori Penggunaan Product -->
    <record id="action_construction_usage_category" model="ir.actions.act_window">
        <field name="name">Kategori Penggunaan Product</field>
        <field name="res_model">construction.usage.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
