    <record id="inherit_product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="attributes">
                <attribute name="class">d-none</attribute>
            </xpath>
            <xpath expr="//form/sheet" position="before">
                <header>
                    <button type="object"
                        name= "action_view_stock_move_lines"
                        invisible="type != 'consu'"
                        class="oe_stat_button" icon="fa-exchange"
                        groups="stock.group_stock_user">Moves History
                    </button>
                </header>
                
            </xpath>
            <xpath expr="//page[@name='general_information']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//page[@name='sales']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//page[@name='sales_price']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//page[@name='purchase']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//page[@name='inventory']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
        </field>
    </record>
    <record id="construction_view_product_template_form" model="ir.ui.view">
        <field name="name">product.template.form.construction</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='variants']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            
            <!-- Tambahkan field umum MODUL PRODUCT -->
            <xpath expr="//page[@name='general_information']" position="before">
                             

                <!-- PAGE: BAHAN -->
                <page string="Bahan"
                      invisible="type_master_data != 'bahan'">
                    <group>
                        <group name="internal_notes" string="Deskripsi" colspan="4">
                            <field colspan="2" name="description" nolabel="1" placeholder="This note of description is only for internal purposes."/>
                        </group>
                        <group string="Construction">
                            <field name="construction_product_type" widget="radio" options="{'horizontal': True}"/>
                            <field name="en_name" />
                            <field name="default_code" string="Kode Bahan"/>
                            <field name="type_master_data"/>
                            <field name="construction_usage"/>
                            <field name="rap_coefficient"/>
                            <field name="rap_uom_id"/>
                            <field name="uom_id" widget="many2one_uom" string="Satuan Bahan"
                                options="{'no_quick_create': True}"
                            />
                        </group>
                        <group string="Lokasi &amp; Harga">
                            <field name="city_id" />
                            <field name="construction_price"
                                widget="monetary"
                                options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                            <field name="tanggal_harga" />
                        </group>
                        <group>
                            <label for="usage_category_ids"/>
                            <div>
                                <field name="usage_category_ids" class="mb-0" widget="many2many_checkboxes"/>
                            </div>
                        </group>
                        <group>
                            <field name="bahan_group_id"/>
                            <field name="bahan_brand"/>
                        </group>
                        <group>
                            <label for="weight"/>
                            <div class="o_row" name="weight">
                                <field name="weight" class="oe_inline" style="max-width: 7rem;"/>
                                <field name="weight_uom_id"/>
                            </div>
                            <field name="bahan_spec"/>
                        </group>
                    </group>
                </page>

                <!-- PAGE: UPAH -->
                <page string="Upah"
                      invisible="type_master_data != 'upah'">
                    <group>
                        <group name="internal_notes" string="Deskripsi" colspan="4">
                            <field colspan="2" name="description" nolabel="1" placeholder="This note of description is only for internal purposes."/>
                        </group>
                        <group string="Construction">
                            <field name="construction_product_type" widget="radio" options="{'horizontal': True}"/>
                            <field name="en_name" />
                            <field name="default_code" string="Kode Upah"/>
                            <field name="type_master_data"/>
                            <field name="uom_id" widget="many2one_uom" string="Satuan Upah"
                                options="{'no_quick_create': True}"
                            />
                        </group>
                        <group string="Lokasi &amp; Harga">
                            <field name="city_id" />
                            <field name="construction_price"
                                widget="monetary"
                                options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                            <field name="tanggal_harga" />
                            <field name="is_status_upah_alat"/>
                        </group>
                        <group string="Integrasi COA">
                            <field name="product_account_id" options="{'no_create': True}"/>
                            <field name="skill_level_id" invisible="1"/>
                        </group>
                    </group>
                </page>

                <!-- PAGE: OVERHEAD -->
                <page string="Overhead"
                      invisible="type_master_data != 'overhead'">
                    <group>
                        <group name="internal_notes" string="Deskripsi" colspan="4">
                            <field colspan="2" name="description" nolabel="1" placeholder="This note of description is only for internal purposes."/>
                        </group>
                        <group string="Construction">
                            <field name="construction_product_type" widget="radio" options="{'horizontal': True}"/>
                            <field name="en_name" />
                            <field name="default_code" string="Kode Overhead"/>
                            <field name="type_master_data"/>
                            <field name="uom_id" widget="many2one_uom" string="Satuan Overhead"
                                options="{'no_quick_create': True}"
                            />
                            <field name="equipment_category_id"/>
                            <field name="rental_unit"/>
                        </group>
                        <group string="Lokasi &amp; Harga">
                            <field name="city_id" />
                            <field name="construction_price"
                                widget="monetary"
                                options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                            <field name="tanggal_harga" />
                        </group>
                        <group string="Integrasi COA">
                            <field name="product_account_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                </page>

                <!-- PAGE: JASA -->
                <page string="Jasa"
                      invisible="type_master_data != 'jasa'">
                    <group>
                        <group name="internal_notes" string="Deskripsi" colspan="4">
                            <field colspan="2" name="description" nolabel="1" placeholder="This note of description is only for internal purposes."/>
                        </group>
                        <group string="Construction">
                            <field name="construction_product_type" widget="radio" options="{'horizontal': True}"/>
                            <field name="en_name" />
                            <field name="default_code" string="Kode Alat"/>
                            <field name="type_master_data"/>
                            <field name="uom_id" widget="many2one_uom" string="Satuan Alat"
                                options="{'no_quick_create': True}"
                            />
                        </group>
                        <group string="Lokasi &amp; Harga">
                            <field name="city_id" />
                            <field name="construction_price"
                                widget="monetary"
                                options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                            <field name="tanggal_harga" />
                        </group>
                        <group string="Integrasi COA">
                            <field name="kantor_account_id" options="{'no_create': True}"/>
                            <field name="workshop_account_id" options="{'no_create': True}"/>
                            <field name="proyek_account_id" options="{'no_create': True}"/>
                        </group>
                        <!-- <group>
                            <field name="service_category_id"/>
                        </group> -->
                    </group>
                </page>

                <!-- PAGE: SEWA ALAT -->
                <page string="Sewa Alat"
                      invisible="type_master_data != 'sewa_alat'">
                    <group>
                        <group name="internal_notes" string="Deskripsi" colspan="4">
                            <field colspan="2" name="description" nolabel="1" placeholder="This note of description is only for internal purposes."/>
                        </group>
                        <group string="Construction">
                            <field name="construction_product_type" widget="radio" options="{'horizontal': True}"/>
                            <field name="en_name" />
                            <field name="default_code" string="Kode Alat"/>
                            <field name="type_master_data"/>
                            <field name="uom_id" widget="many2one_uom" string="Satuan Alat"
                                options="{'no_quick_create': True}"
                            />
                            <field name="equipment_category_id"/>
                            <field name="rental_unit"/>
                        </group>
                        <group string="Lokasi &amp; Harga">
                            <field name="city_id" />
                            <field name="construction_price"
                                widget="monetary"
                                options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                            <field name="tanggal_harga" />
                        </group>
                        <group string="Integrasi COA">
                            <field name="product_account_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                </page>

                <page string="Child Products" invisible="type_master_data != 'bahan'">
                    <group>
                        <group>
                            <field name="product_level" readonly="1"/>
                            <field name="parent_product_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <field name="child_product_ids" context="{'default_type':type, 'default_type_master_data':type_master_data}">
                            <list>
                                <field name="default_code" string="Kode Bahan"/>
                                <field name="name" string="Nama Bahan"/>
                                <field name="construction_price" string="Harga" widget="monetary"
                                    options="{'currency_field': 'currency_id'}"/>
                                <field name="uom_id" string="Satuan Bahan"/>
                                <field name="active" string="Status" widget="boolean"/>
                                <field name="create_date" string="Created at"/>
                                <field name="write_date" string="Updated at"/>
                            </list>
                        </field>
                    </group>
                </page>
                <page string="Child Products" invisible="type_master_data != 'upah'">
                    <group>
                        <group>
                            <field name="product_level" readonly="1"/>
                            <field name="parent_product_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <field name="child_product_ids"
                            context="{'default_type_master_data': type_master_data, 'default_construction_product_type': construction_product_type}">
                            <list create="0" edit="0">
                                <field name="default_code" string="Kode Upah"/>
                                <field name="name" string="Nama Upah"/>
                                <field name="construction_price" string="Harga" widget="monetary"
                                    options="{'currency_field': 'currency_id'}"/>
                                <field name="uom_id" string="Satuan Upah"/>
                                <field name="active" string="Status" widget="boolean"/>
                                <field name="create_date" string="Created at"/>
                                <field name="write_date" string="Updated at"/>
                            </list>
                        </field>
                    </group>
                </page>
                <page string="Child Products" invisible="type_master_data != 'sewa_alat'">
                    <group>
                        <group>
                            <field name="product_level" readonly="1"/>
                            <field name="parent_product_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <field name="child_product_ids"
                            context="{'default_type_master_data': type_master_data, 'default_construction_product_type': construction_product_type}">
                            <list create="0" edit="0">
                                <field name="default_code" string="Kode Sewa Alat"/>
                                <field name="name" string="Nama Sewa Alat"/>
                                <field name="construction_price" string="Harga" widget="monetary"
                                    options="{'currency_field': 'currency_id'}"/>
                                <field name="uom_id" string="Satuan Sewa Alat"/>
                                <field name="active" string="Status" widget="boolean"/>
                                <field name="create_date" string="Created at"/>
                                <field name="write_date" string="Updated at"/>
                            </list>
                        </field>
                    </group>
                </page>
                <page string="Child Products" invisible="type_master_data != 'overhead'">
                    <group>
                        <group>
                            <field name="product_level" readonly="1"/>
                            <field name="parent_product_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <field name="child_product_ids"
                            context="{'default_type_master_data': type_master_data, 'default_construction_product_type': construction_product_type}">
                            <list create="0" edit="0">
                                <field name="default_code" string="Kode Overhead"/>
                                <field name="name" string="Nama Overhead"/>
                                <field name="construction_price" string="Harga" widget="monetary"
                                    options="{'currency_field': 'currency_id'}"/>
                                <field name="uom_id" string="Satuan Overhead"/>
                                <field name="active" string="Status" widget="boolean"/>
                                <field name="create_date" string="Created at"/>
                                <field name="write_date" string="Updated at"/>
                            </list>
                        </field>
                    </group>
                </page>
                <page string="Child Products" invisible="type_master_data != 'jasa'">
                    <group>
                        <group>
                            <field name="product_level" readonly="1"/>
                            <field name="parent_product_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <field name="child_product_ids"
                            context="{'default_type_master_data': type_master_data, 'default_construction_product_type': construction_product_type}">
                            <list create="0" edit="0">
                                <field name="default_code" string="Kode Jasa"/>
                                <field name="name" string="Nama Jasa"/>
                                <field name="construction_price" string="Harga" widget="monetary"
                                    options="{'currency_field': 'currency_id'}"/>
                                <field name="uom_id" string="Satuan Jasa"/>
                                <field name="active" string="Status" widget="boolean"/>
                                <field name="create_date" string="Created at"/>
                                <field name="write_date" string="Updated at"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
