
<odoo>
    <data>
        

        <menuitem
            id="menu_construction_root"
            name="Construction"
            web_icon="construction,static/description/icon.png"
            sequence="30"
            />

        <record id="open_view_project_all_cons" model="ir.actions.act_window">
            <field name="name">Projects</field>
            <field name="res_model">project.project</field>
            <field name="domain">[("is_template", "=", False)]</field>
            <field name="context">{'display_milestone_deadline': True}</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="project.view_project_project_filter"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No projects found. Let's create one!
                </p>
                <p>
                    Create projects to organize your tasks. Define a different workflow for each project.
                </p>
            </field>
        </record>

        <menuitem
            id="menu_construction_project"
            name="Project"
            parent="menu_construction_root"
            action="open_view_project_all_cons"
            sequence="10"
        />
        
        <menuitem id="menu_construction_rap_root"
                  name="RAP &amp; PFC"
                  parent="menu_construction_root"
                  sequence="15"/>

        <menuitem id="menu_construction_rap"
                  name="RAP"
                  parent="menu_construction_rap_root"
                  action="construction.action_project_rap"
                  sequence="10"/>

        <menuitem id="menu_construction_pfc"
                  name="PFC"
                  parent="menu_construction_rap_root"
                  action="construction.action_project_pfc"
                  sequence="20"/>

        <menuitem
            id="menu_construction_configuration"
            name="Configuration"
            parent="menu_construction_root"
            sequence="99"
        />

        <record id="action_construction_stock_warehouse" model="ir.actions.act_window">
            <field name="name">Gudang</field>
            <field name="res_model">stock.warehouse</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
            id="menu_construction_config_warehouse"
            name="Gudang"
            parent="menu_construction_configuration"
            action="action_construction_stock_warehouse"
            sequence="10"
        />

        <!-- Location (stock.location) -->
        <record id="action_construction_stock_location" model="ir.actions.act_window">
            <field name="name">Lokasi Gudang</field>
            <field name="res_model">stock.location</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
            id="menu_construction_config_location"
            name="Lokasi"
            parent="menu_construction_configuration"
            action="action_construction_stock_location"
            sequence="20"
        />

        <menuitem
            id="menu_construction_products_root"
            name="Masters"
            parent="menu_construction_root"
            sequence="30"
        />

        <record id="action_construction_product_bahan" model="ir.actions.act_window">
            <field name="name">Master Bahan</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="construction.construction_product_template_tree_bahan"/>
            <field name="domain">[('type_master_data', '=', 'bahan')]</field>
            <field name="context">
                {
                    'default_type_master_data': 'bahan',
                    'default_construction_product_type': 'consu'
                }
            </field>
        </record>

        <menuitem
            id="menu_construction_product_bahan"
            name="Master Bahan"
            parent="menu_construction_products_root"
            action="action_construction_product_bahan"
            sequence="10"
        />

        <record id="action_construction_product_upah" model="ir.actions.act_window">
            <field name="name">Master Upah</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="construction.construction_product_template_tree_upah"/>
            <field name="domain">[('type_master_data', '=', 'upah')]</field>
            <field name="context">
                {
                    'default_type_master_data': 'upah',
                    'default_construction_product_type': 'service'
                }
            </field>
        </record>

        <menuitem
            id="menu_construction_product_upah"
            name="Master Upah"
            parent="menu_construction_products_root"
            action="action_construction_product_upah"
            sequence="20"
        />

        <!-- Master Overhead -->
        <record id="action_construction_product_overhead" model="ir.actions.act_window">
            <field name="name">Master Overhead</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="construction.construction_product_template_tree_overhead"/>
            <!-- hanya parent, child tidak tampil di menu master -->
            <field name="domain">[('type_master_data', '=', 'overhead')]</field>
            <field name="context">
                {
                    'default_type_master_data': 'overhead',
                    'default_construction_product_type': 'service'
                }
            </field>
        </record>

        <menuitem
            id="menu_construction_product_overhead"
            name="Master Overhead"
            parent="menu_construction_products_root"
            action="action_construction_product_overhead"
            sequence="30"
        />

        <!-- Master Jasa -->
        <record id="action_construction_product_jasa" model="ir.actions.act_window">
            <field name="name">Master Jasa</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="construction.construction_product_template_tree_jasa"/>
            <field name="domain">[('type_master_data', '=', 'jasa')]</field>
            <field name="context">
                {
                    'default_type_master_data': 'jasa',
                    'default_construction_product_type': 'service'
                }
            </field>
        </record>

        <menuitem
            id="menu_construction_product_jasa"
            name="Master Jasa"
            parent="menu_construction_products_root"
            action="action_construction_product_jasa"
            sequence="40"
        />

        <record id="action_construction_product_sewa_alat" model="ir.actions.act_window">
            <field name="name">Master Sewa Alat</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="construction.construction_product_template_tree_sewa_alat"/>
            <!-- hanya parent, child tidak tampil di menu master -->
            <field name="domain">[('type_master_data', '=', 'sewa_alat')]</field>
            <field name="context">
                {
                    'default_type_master_data': 'sewa_alat',
                    'default_construction_product_type': 'service'
                }
            </field>
        </record>

        <menuitem
            id="menu_construction_product_sewa_alat"
            name="Master Sewa Alat"
            parent="menu_construction_products_root"
            action="action_construction_product_sewa_alat"
            sequence="50"
        />

        <record id="action_construction_hr_employee" model="ir.actions.act_window">
            <field name="name">Employees</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('active', '=', True)]</field>
        </record>

        <menuitem
            id="menu_construction_employee"
            name="Employee"
            parent="menu_construction_root"
            action="action_construction_hr_employee"
            sequence="40"
        />

        <record id="action_construction_suppliers" model="ir.actions.act_window">
            <field name="name">Pemasok</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('supplier_rank', '>', 0)]</field>
            <field name="context">
                {
                    'default_company_type': 'company',
                    'default_supplier_rank': 1
                }
            </field>
        </record>

        <menuitem
            id="menu_construction_suppliers"
            name="Pemasok"
            parent="menu_construction_root"
            action="action_construction_suppliers"
            sequence="50"
        />

        <menuitem id="menu_res_kantor" parent="menu_construction_configuration" action="construction.action_res_kantor" sequence="30"/>
        <menuitem id="menu_kelompok_proyek" parent="menu_construction_configuration" action="construction.action_kelompok_proyek" sequence="35"/>
        <menuitem id="menu_res_bidang" parent="menu_construction_configuration" action="construction.action_res_bidang" sequence="40"/>
        <menuitem id="menu_res_sub_bidang" parent="menu_construction_configuration" action="construction.action_res_sub_bidang" sequence="45"/>
        <menuitem id="menu_status_proyek" parent="menu_construction_configuration" action="construction.action_status_proyek" sequence="50"/>

        <menuitem id="menu_supplier_category"
              name="Kategori Pemasok"
              parent="menu_construction_configuration"
              action="construction.action_supplier_category"
              sequence="55"/>

        <menuitem id="menu_supplier_service"
                name="Layanan Pemasok"
                parent="menu_construction_configuration"
                action="construction.action_supplier_service"
                sequence="60"/>

        <menuitem
            id="menu_construction_product_configuration"
            name="Master Construction"
            parent="menu_construction_configuration"
            sequence="65"
        />
        <menuitem id="menu_construction_pekerjaan"
                  name="Pekerjaan"
                  parent="menu_construction_configuration"
                  action="construction.action_project_pekerjaan"
                  sequence="70"/>

        <menuitem id="menu_construction_sub_pekerjaan"
                  name="Sub Pekerjaan"
                  parent="menu_construction_configuration"
                  action="construction.action_project_sub_pekerjaan"
                  sequence="75"/>

        <menuitem
            id="menu_construction_material_group"
            name="Kelompok Bahan"
            parent="menu_construction_product_configuration"
            action="action_construction_material_group"
            sequence="10"
        />

        <menuitem
            id="menu_construction_skill_level"
            name="Level Keahlian"
            parent="menu_construction_product_configuration"
            action="action_construction_skill_level"
            sequence="20"
        />

        <menuitem
            id="menu_construction_overhead_type"
            name="Tipe Overhead"
            parent="menu_construction_product_configuration"
            action="action_construction_overhead_type"
            sequence="30"
        />

        <menuitem
            id="menu_construction_service_category"
            name="Kategori Jasa Master"
            parent="menu_construction_product_configuration"
            action="action_construction_service_category"
            sequence="40"
        />

        <menuitem
            id="menu_construction_equipment_category"
            name="Kategori Alat"
            parent="menu_construction_product_configuration"
            action="action_construction_equipment_category"
            sequence="50"
        />

        <menuitem
            id="menu_construction_usage_category"
            name="Kategori Penggunaan"
            parent="menu_construction_product_configuration"
            action="action_construction_usage_category"
            sequence="60"
        />
    </data>
</odoo>
