<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_project_rap" model="ir.actions.act_window">
            <field name="name">RAP</field>
            <field name="res_model">project.rap</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('type', '=', 'rap')]</field>
            <field name="context">{'default_type': 'rap'}</field>
        </record>

        <record id="action_project_pfc" model="ir.actions.act_window">
            <field name="name">PFC</field>
            <field name="res_model">project.rap</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('type', '=', 'pfc')]</field>
            <field name="context">{'default_type': 'pfc'}</field>
        </record>

        <record id="view_project_rap_tree" model="ir.ui.view">
            <field name="name">project.rap.list</field>
            <field name="model">project.rap</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="type"/>
                    <field name="project_id"/>
                    <field name="total_nilai_rap"/>
                    <field name="selisih_kon_rap"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_project_rap_form" model="ir.ui.view">
            <field name="name">project.rap.form</field>
            <field name="model">project.rap</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_request_approval" type="object" string="Request Approval"
                                class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_approve" type="object" string="Approve"
                                class="btn-primary" invisible="state != 'request_approval'"/>
                        <button name="action_set_draft" type="object" string="Reset to Draft"
                                class="btn-secondary" invisible="state == 'draft'"/>

                        <button name="action_open_import_template_wizard" type="object" string="Add from Template"
                                class="btn-secondary" invisible="state == 'approved' or id == False"/>
                        <button name="action_open_save_as_template_wizard" type="object" string="Save as Template"
                                class="btn-secondary" invisible="id == False"/>

                        <button name="action_open_copy_wizard" type="object" string="Copy to Another Project"
                                class="btn-secondary" invisible="id == False"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,request_approval,approved"/>
                    </header>

                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="type"/>
                                <field name="project_id"/>
                            </group>
                            <group>
                                <field name="nilai_kontrak" readonly="1"/>
                                <field name="total_nilai_rap" readonly="1"/>
                                <field name="selisih_kon_rap" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Pekerjaan">
                                <field name="pekerjaan_ids" context="{'default_rap_id': id}" readonly="state == 'approved'">
                                    <list create="1" edit="1" delete="1">
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="total_harga" readonly="1"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Approval">
                                <group>
                                    <field name="user_request_id" readonly="1"/>
                                    <field name="user_approve_id" readonly="1"/>
                                    <field name="tanggal_disetujui" readonly="1"/>
                                    <field name="comment" readonly="state == 'approved'"/>
                                </group>
                            </page>

                            <page string="Notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
