<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_project_rap" model="ir.actions.act_window">
            <field name="name">RAP</field>
            <field name="res_model">project.rap</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('type', '=', 'rap')]</field>
            <field name="context">{'default_type': 'rap'}</field>
        </record>

        <record id="action_project_pfc" model="ir.actions.act_window">
            <field name="name">PFC</field>
            <field name="res_model">project.rap</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('type', '=', 'pfc')]</field>
            <field name="context">{'default_type': 'pfc'}</field>
        </record>

        <record id="view_project_rap_tree" model="ir.ui.view">
            <field name="name">project.rap.list</field>
            <field name="model">project.rap</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="type"/>
                    <field name="project_id"/>
                    <field name="total_nilai_rap"/>
                    <field name="selisih_kon_rap"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_project_rap_form" model="ir.ui.view">
            <field name="name">project.rap.form</field>
            <field name="model">project.rap</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_request_approval" type="object" string="Request Approval"
                                class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_approve" type="object" string="Approve"
                                class="btn-primary" invisible="state != 'request_approval'"/>
                        <button name="action_set_draft" type="object" string="Reset to Draft"
                                class="btn-secondary" invisible="state == 'draft'"/>

                        <button name="action_open_import_template_wizard" type="object" string="Add from Template"
                                class="btn-secondary" invisible="state == 'approved' or id == False"/>
                        <button name="action_open_save_as_template_wizard" type="object" string="Save as Template"
                                class="btn-secondary" invisible="id == False"/>
                        <button name="action_create_pfc" type="object" string="Create PFC"
                                class="btn-primary"
                                invisible="type != 'rap' or state != 'approved' or id == False"/>
                        <button name="action_open_copy_wizard" type="object" string="Copy to Another Project"
                                class="btn-secondary" invisible="id == False"/>
                        <button name="action_create_fpd"
                                type="object"
                                string="Create FPD"
                                class="oe_highlight"/>
                        <button name="action_open_create_po_wizard"
                            type="object"
                            string="Create Purchase Order"
                            class="btn-primary"
                            invisible="id == False"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,request_approval,approved"/>
                    </header>

                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button type="object"
                                    name="action_view_purchase_orders"
                                    class="oe_stat_button"
                                    icon="fa-shopping-cart"
                                    invisible="purchase_order_count == 0">
                                <field name="purchase_order_count" widget="statinfo" string="Purchase Orders"/>
                            </button>
                            <button type="object"
                                    name="action_view_pfcs"
                                    class="oe_stat_button"
                                    icon="fa-files-o"
                                    invisible="type != 'rap' or pfc_count == 0">
                                <field name="pfc_count" widget="statinfo" string="PFC"/>
                            </button>
                            <button name="action_open_fpd"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-file-text-o"
                                    invisible="fpd_count == 0">
                                <field name="fpd_count" widget="statinfo" string="FPD"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="type"/>
                                <field name="project_id"/>
                                <field name="rap_origin_id" invisible="type != 'pfc'" readonly="1"/>
                            </group>
                            <group>
                                <field name="nilai_kontrak" readonly="1"/>
                                <field name="total_nilai_rap" readonly="1" invisible="type != 'rap'"/>
                                <field name="selisih_kon_rap" readonly="1" invisible="type != 'rap'"/>
                                <field name="total_nilai_pfc" readonly="1" invisible="type != 'pfc'"/>
                                <field name="selisih_kon_pfc" readonly="1" invisible="True"/>
                                <field name="total_nilai_pfc_on_rap" readonly="1" invisible="type != 'rap'"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Pekerjaan">
                                <field name="pekerjaan_ids" context="{'default_rap_id': id}" readonly="state == 'approved'">
                                    <list create="1" edit="1" delete="1">
                                        <field name="rap_id" column_invisible="1"/>
                                        <field name="code" style="30px !important"/>
                                        <field name="name" style="150px !important"/>
                                        <field name="total_harga"  readonly="1"/>
                                    </list>
                                    <form>
                                        <sheet>
                                            <group>
                                                <field name="code"/>
                                                <field name="name"/>
                                                <field name="total_harga" readonly="1"/>
                                                <field name="template_id" invisible="1"/>
                                                <field name="id" invisible="1" />
                                                <field name="rap_state" invisible="1"/>
                                            </group>

                                            <notebook>
                                                <page string="Sub Pekerjaan">
                                                    <field name="sub_pekerjaan_ids"
                                                        context="{'default_pekerjaan_id': id}"
                                                        readonly="rap_state == 'approved'">
                                                        <list create="1" edit="1" delete="1">
                                                            <field name="name"/>
                                                            <field name="uom_id"/>
                                                            <field name="volume"/>
                                                            <field name="total_harga" readonly="1"/>
                                                        </list>
                                                        <form>
                                                            <sheet>
                                                                <group>
                                                                    <field name="pekerjaan_id" invisible="1"/>
                                                                    <field name="name"/>
                                                                    <field name="uom_id"/>
                                                                    <field name="volume"/>
                                                                    <field name="harga_satuan"/>
                                                                    <field name="total_harga" readonly="1"/>
                                                                    <field name="total_harga_rap" readonly="1"/>
                                                                    <field name="template_id" invisible="1"/>
                                                                    <field name="id" invisible="1"/>
                                                                    <field name="rap_state" invisible="1"/>
                                                                </group>

                                                                <notebook>
                                                                    <page string="Bahan">
                                                                        <field name="master_bahan_ids"
                                                                            context="{'default_sub_pekerjaan_id': id}"
                                                                            readonly="rap_state == 'approved'">
                                                                            <list editable="bottom">
                                                                                <field name="product_id" context="{'default_type':'consu', 'default_type_master_data':'bahan'}"/>
                                                                                <field name="code" readonly="1"/>
                                                                                <field name="uom_id" readonly="1"/>
                                                                                <field name="volume"/>
                                                                                <field name="harga_satuan"/>
                                                                                <field name="total_harga" readonly="1"/>
                                                                            </list>
                                                                        </field>
                                                                    </page>

                                                                    <page string="Upah">
                                                                        <field name="master_upah_ids"
                                                                            context="{'default_sub_pekerjaan_id': id}"
                                                                            readonly="rap_state == 'approved'">
                                                                            <list editable="bottom">
                                                                                <field name="product_id" context="{'default_type':'service', 'default_type_master_data':'upah'}"/>
                                                                                <field name="code" readonly="1"/>
                                                                                <field name="uom_id" readonly="1"/>
                                                                                <field name="volume"/>
                                                                                <field name="harga_satuan"/>
                                                                                <field name="total_harga" readonly="1"/>
                                                                            </list>
                                                                        </field>
                                                                    </page>

                                                                    <page string="Sewa Alat">
                                                                        <field name="master_sewa_alat_ids"
                                                                            context="{'default_sub_pekerjaan_id': id}"
                                                                            readonly="rap_state == 'approved'">
                                                                            <list editable="bottom">
                                                                                <field name="product_id" context="{'default_type':'service', 'default_type_master_data':'sewa_alat'}"/>
                                                                                <field name="code" readonly="1"/>
                                                                                <field name="uom_id" readonly="1"/>
                                                                                <field name="volume"/>
                                                                                <field name="harga_satuan"/>
                                                                                <field name="total_harga" readonly="1"/>
                                                                            </list>
                                                                        </field>
                                                                    </page>

                                                                    <page string="Overhead">
                                                                        <field name="master_overhead_ids"
                                                                            context="{'default_sub_pekerjaan_id': id}"
                                                                            readonly="rap_state == 'approved'">
                                                                            <list editable="bottom">
                                                                                <field name="product_id" context="{'default_type':'service', 'default_type_master_data':'overhead'}"/>
                                                                                <field name="code" readonly="1"/>
                                                                                <field name="uom_id" readonly="1"/>
                                                                                <field name="volume"/>
                                                                                <field name="harga_satuan"/>
                                                                                <field name="total_harga" readonly="1"/>
                                                                            </list>
                                                                        </field>
                                                                    </page>

                                                                    <page string="Jasa">
                                                                        <field name="master_jasa_ids"
                                                                            context="{'default_sub_pekerjaan_id': id}"
                                                                            readonly="rap_state == 'approved'">
                                                                            <list editable="bottom">
                                                                                <field name="product_id" context="{'default_type':'service', 'default_type_master_data':'jasa'}"/>
                                                                                <field name="code" readonly="1"/>
                                                                                <field name="uom_id" readonly="1"/>
                                                                                <field name="volume"/>
                                                                                <field name="harga_satuan"/>
                                                                                <field name="total_harga" readonly="1"/>
                                                                            </list>
                                                                        </field>
                                                                    </page>
                                                                </notebook>
                                                            </sheet>
                                                        </form>
                                                    </field>
                                                </page>
                                            </notebook>
                                        </sheet>
                                    </form>
                                </field>
                            </page>

                            <page string="Approval">
                                <group>
                                    <field name="user_request_id" readonly="1"/>
                                    <field name="user_approve_id" readonly="1"/>
                                    <field name="tanggal_disetujui" readonly="1"/>
                                    <field name="comment" readonly="state == 'approved'"/>
                                </group>
                            </page>
                            <page string="PFC" invisible="type != 'rap'">
                                <field name="pfc_ids" nolabel="1" readonly="1">
                                    <list create="0" edit="0" delete="0">
                                        <field name="name" string="Name"/>
                                        <field name="total_nilai_rap" string="Total Nilai RAP" readonly="1"/>
                                        <field name="state" string="Status"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
