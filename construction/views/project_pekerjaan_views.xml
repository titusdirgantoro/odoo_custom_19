<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_project_pekerjaan" model="ir.actions.act_window">
            <field name="name">Pekerjaan</field>
            <field name="res_model">project.pekerjaan</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="view_project_pekerjaan_tree" model="ir.ui.view">
            <field name="name">project.pekerjaan.list</field>
            <field name="model">project.pekerjaan</field>
            <field name="arch" type="xml">
                <list>
                    <field name="rap_id"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="total_harga"/>
                </list>
            </field>
        </record>

        <!-- Form: O2M jadi PAGE -->
        <record id="view_project_pekerjaan_form" model="ir.ui.view">
            <field name="name">project.pekerjaan.form</field>
            <field name="model">project.pekerjaan</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="rap_id"/>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="total_harga" readonly="1"/>
                            <field name="template_id" invisible="1"/>
                            <field name="id" invisible="1" />
                            <field name="rap_state" invisible="1"/>
                        </group>

                        <notebook>
                            <page string="Sub Pekerjaan">
                                <field name="sub_pekerjaan_ids"
                                       context="{'default_pekerjaan_id': id}"
                                       readonly="rap_state == 'approved'">
                                    <list create="1" edit="1" delete="1">
                                        <field name="name"/>
                                        <field name="uom_id"/>
                                        <field name="volume"/>
                                        <field name="total_harga" readonly="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
