<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- list view: Kategori Jasa Product -->
    <record id="view_construction_service_category_tree" model="ir.ui.view">
        <field name="name">construction.service.category.list</field>
        <field name="model">construction.service.category</field>
        <field name="arch" type="xml">
            <list string="Kategori Jasa Product">
                <field name="code"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form view: Kategori Jasa Product -->
    <record id="view_construction_service_category_form" model="ir.ui.view">
        <field name="name">construction.service.category.form</field>
        <field name="model">construction.service.category</field>
        <field name="arch" type="xml">
            <form string="Kategori Jasa Product">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: Kategori Jasa Product -->
    <record id="action_construction_service_category" model="ir.actions.act_window">
        <field name="name">Kategori Jasa Product</field>
        <field name="res_model">construction.service.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
