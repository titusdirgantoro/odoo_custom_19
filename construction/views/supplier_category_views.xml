<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_supplier_category_tree" model="ir.ui.view">
        <field name="name">supplier.category.list</field>
        <field name="model">supplier.category</field>
        <field name="arch" type="xml">
            <list string="Kategori Pemasok">
                <field name="code"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_supplier_category_form" model="ir.ui.view">
        <field name="name">supplier.category.form</field>
        <field name="model">supplier.category</field>
        <field name="arch" type="xml">
            <form string="Kategori Pemasok">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_supplier_category" model="ir.actions.act_window">
        <field name="name">Kategori Pemasok</field>
        <field name="res_model">supplier.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
