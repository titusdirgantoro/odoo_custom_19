<odoo>
    <record id="view_kelompok_proyek_list" model="ir.ui.view">
        <field name="name">kelompok.proyek.list</field>
        <field name="model">kelompok.proyek</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_kelompok_proyek_form" model="ir.ui.view">
        <field name="name">kelompok.proyek.form</field>
        <field name="model">kelompok.proyek</field>
        <field name="arch" type="xml">
            <form>
                <sheet><group>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="active"/>
                </group></sheet>
            </form>
        </field>
    </record>

    <record id="action_kelompok_proyek" model="ir.actions.act_window">
        <field name="name">Kelompok Proyek</field>
        <field name="res_model">kelompok.proyek</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
