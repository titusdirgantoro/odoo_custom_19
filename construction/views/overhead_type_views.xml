<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- list view: Tipe Overhead -->
    <record id="view_construction_overhead_type_tree" model="ir.ui.view">
        <field name="name">construction.overhead.type.list</field>
        <field name="model">construction.overhead.type</field>
        <field name="arch" type="xml">
            <list string="Tipe Overhead">
                <field name="code"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form view: Tipe Overhead -->
    <record id="view_construction_overhead_type_form" model="ir.ui.view">
        <field name="name">construction.overhead.type.form</field>
        <field name="model">construction.overhead.type</field>
        <field name="arch" type="xml">
            <form string="Tipe Overhead">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: Tipe Overhead -->
    <record id="action_construction_overhead_type" model="ir.actions.act_window">
        <field name="name">Tipe Overhead</field>
        <field name="res_model">construction.overhead.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
