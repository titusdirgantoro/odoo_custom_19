<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- list view: Level Keahlian -->
    <record id="view_construction_skill_level_tree" model="ir.ui.view">
        <field name="name">construction.skill.level.list</field>
        <field name="model">construction.skill.level</field>
        <field name="arch" type="xml">
            <list string="Level Keahlian">
                <field name="code"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form view: Level Keahlian -->
    <record id="view_construction_skill_level_form" model="ir.ui.view">
        <field name="name">construction.skill.level.form</field>
        <field name="model">construction.skill.level</field>
        <field name="arch" type="xml">
            <form string="Level Keahlian">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: Level Keahlian -->
    <record id="action_construction_skill_level" model="ir.actions.act_window">
        <field name="name">Level Keahlian</field>
        <field name="res_model">construction.skill.level</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
