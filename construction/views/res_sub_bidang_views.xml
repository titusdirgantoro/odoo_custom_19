<odoo>
    <record id="view_res_sub_bidang_list" model="ir.ui.view">
        <field name="name">res.sub.bidang.list</field>
        <field name="model">res.sub.bidang</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="bidang_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_res_sub_bidang_form" model="ir.ui.view">
        <field name="name">res.sub.bidang.form</field>
        <field name="model">res.sub.bidang</field>
        <field name="arch" type="xml">
            <form>
                <sheet><group>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="bidang_id"/>
                    <field name="active"/>
                </group></sheet>
            </form>
        </field>
    </record>

    <record id="action_res_sub_bidang" model="ir.actions.act_window">
        <field name="name">Sub Bidang Proyek</field>
        <field name="res_model">res.sub.bidang</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
