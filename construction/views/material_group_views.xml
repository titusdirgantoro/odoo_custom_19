<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- list view: Kelompok Bahan -->
    <record id="view_construction_material_group_tree" model="ir.ui.view">
        <field name="name">construction.material.group.list</field>
        <field name="model">construction.material.group</field>
        <field name="arch" type="xml">
            <list string="Kelompok Bahan">
                <field name="code"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form view: Kelompok Bahan -->
    <record id="view_construction_material_group_form" model="ir.ui.view">
        <field name="name">construction.material.group.form</field>
        <field name="model">construction.material.group</field>
        <field name="arch" type="xml">
            <form string="Kelompok Bahan">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: Kelompok Bahan -->
    <record id="action_construction_material_group" model="ir.actions.act_window">
        <field name="name">Kelompok Bahan</field>
        <field name="res_model">construction.material.group</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
