<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- list view: Kategori Alat -->
    <record id="view_construction_equipment_category_tree" model="ir.ui.view">
        <field name="name">construction.equipment.category.list</field>
        <field name="model">construction.equipment.category</field>
        <field name="arch" type="xml">
            <list string="Kategori Alat">
                <field name="code"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form view: Kategori Alat -->
    <record id="view_construction_equipment_category_form" model="ir.ui.view">
        <field name="name">construction.equipment.category.form</field>
        <field name="model">construction.equipment.category</field>
        <field name="arch" type="xml">
            <form string="Kategori Alat">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: Kategori Alat -->
    <record id="action_construction_equipment_category" model="ir.actions.act_window">
        <field name="name">Kategori Alat</field>
        <field name="res_model">construction.equipment.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
