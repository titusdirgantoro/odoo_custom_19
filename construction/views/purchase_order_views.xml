<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <record id="view_purchase_order_form_inherit_construction" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.construction</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_rfq_send']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="after">
                <separator string="RAP Construction"/>
                <field name="rap_id" readonly="1"/>
                <field name="project_id" readonly="1"/>
                <field name="pekerjaan_id"
                        domain="[('rap_id', '=', rap_id)]" readonly="1"/>
                <field name="sub_pekerjaan_id"
                        domain="[('pekerjaan_id', '=', pekerjaan_id)]" readonly="1"/>
                <field name="deliver_to_id" readonly="1"/>
                <field name="expected_arrival" readonly="1"/>
                <field name="is_work_order" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,purchase</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_line_tree_inherit_construction" model="ir.ui.view">
        <field name="name">purchase.order.line.tree.inherit.construction</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="allowed_product_tmpl_ids" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="attributes">
                <attribute name="domain">[('purchase_ok','=',True)] + (allowed_product_tmpl_ids and [('product_tmpl_id','in', allowed_product_tmpl_ids)] or [])</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="attributes">
                <attribute name="domain">[('purchase_ok','=',True)] + (allowed_product_tmpl_ids and [('product_tmpl_id','in', allowed_product_tmpl_ids)] or [])</attribute>
            </xpath>

        </field>
    </record>

    </data>
</odoo>
