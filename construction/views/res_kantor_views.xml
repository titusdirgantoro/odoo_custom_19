<odoo>
    <record id="view_res_kantor_list" model="ir.ui.view">
        <field name="name">res.kantor.list</field>
        <field name="model">res.kantor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_res_kantor_form" model="ir.ui.view">
        <field name="name">res.kantor.form</field>
        <field name="model">res.kantor</field>
        <field name="arch" type="xml">
            <form>
                <sheet><group>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="company_id"/>
                    <field name="active"/>
                </group></sheet>
            </form>
        </field>
    </record>

    <record id="action_res_kantor" model="ir.actions.act_window">
        <field name="name">Kantor</field>
        <field name="res_model">res.kantor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
