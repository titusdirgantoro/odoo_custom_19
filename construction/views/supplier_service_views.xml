<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_supplier_service_tree" model="ir.ui.view">
        <field name="name">supplier.service.list</field>
        <field name="model">supplier.service</field>
        <field name="arch" type="xml">
            <list string="Layanan Pemasok">
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_supplier_service_form" model="ir.ui.view">
        <field name="name">supplier.service.form</field>
        <field name="model">supplier.service</field>
        <field name="arch" type="xml">
            <form string="Layanan Pemasok">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_supplier_service" model="ir.actions.act_window">
        <field name="name">Layanan Pemasok</field>
        <field name="res_model">supplier.service</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
