<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.FormStatusIndicator" t-inherit-mode="extension">

        <xpath expr="//div[contains(@class,'o_form_status_indicator_buttons')]" position="replace">
            <div class="o_form_status_indicator_buttons d-flex"
                 t-att-class="{ invisible: !(props.model.root.isNew or displayButtons) }">

                <button
                    type="button"
                    class="o_form_button_save btn btn-primary"
                    data-hotkey="s"
                    t-on-click.stop="save"
                    data-tooltip="Simpan secara manual"
                    aria-label="Simpan secara manual"
                    t-ref="save">
                    Save
                </button>

                <button
                    type="button"
                    class="o_form_button_cancel btn btn-light border-0 px-1 py-0 lh-sm"
                    data-hotkey="j"
                    t-on-click.stop="discard"
                    data-tooltip="Buang semua perubahan"
                    aria-label="Buang semua perubahan">
                    Discard
                </button>

            </div>
        </xpath>

    </t>
</templates>
